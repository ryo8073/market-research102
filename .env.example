# ============================================================
# CI102 不動産市場分析 API キー設定
# ============================================================

# [必須] e-Stat API（政府統計の総合窓口）
# LQ計算の核心データ（経済センサス産業別従業者数）
# 取得: https://www.e-stat.go.jp/api/
ESTAT_APP_ID=

# [推奨] 国土交通省 不動産情報ライブラリAPI
# 不動産取引価格データ
# 取得: https://www.reinfolib.mlit.go.jp/help/apiManual/
MLIT_API_KEY=

# [任意] Anthropic Claude API（AI分析コメント生成）
# スコアカードの全指標をAIが読み解き、投資判断の示唆を生成
# 取得: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# [任意] Proformer不動産投資診断プロ API（物件レベル投資分析）
# DCF法ベースの投資分析データ（NOI, IRR, NPV等）を取得
PROFORMER_API_KEY=

# [廃止] RESAS API は 2025/3/24 にサービス終了。
# e-Stat API で代替済み。
# RESAS_API_KEY=
