# CI102 Market Analysis — 環境変数テンプレート
# このファイルをコピーして `.env.local` を作り、実際の値を埋める。
# Vercel 環境では Dashboard → Settings → Environment Variables で設定。

# ============================================================================
# 認証 (Phase 6.1)
# ============================================================================

# CCIM 受講生に配布する共有パスワード。
# 未設定の場合は認証が無効化される (ローカル開発用)。
# 本番環境では必ず設定すること。
APP_PASSWORD=

# HMAC 署名鍵 (32文字以上のランダム文字列)。
# 生成例 (PowerShell): -join ((1..48) | %{ [char](Get-Random -Min 33 -Max 126) })
# 生成例 (bash):       openssl rand -base64 32
AUTH_SECRET=

# ============================================================================
# 利用ログ (Phase 6.2 — Vercel KV / Upstash Redis)
# ============================================================================

# Vercel KV 統合時に自動セットされる
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ============================================================================
# データ API キー
# ============================================================================

# e-Stat API (政府統計の総合窓口)
# https://www.e-stat.go.jp/api/ で取得
ESTAT_APP_ID=

# MLIT 不動産情報ライブラリ
# https://www.reinfolib.mlit.go.jp/help/apiManual/ で取得
MLIT_API_KEY=

# Anthropic Claude API (AI レポート生成用)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Proformer DCF API (オプション)
PROFORMER_API_KEY=
